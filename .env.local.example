# Kyla Agent — Environment Variables
# Copy this file to .env.local and fill in your keys
# For Vercel deployment: add these in Project Settings → Environment Variables

# ── GitHub Token (for RepoScan) ───────────────────────────────────────────
# Get at: github.com/settings/tokens → Generate new token (classic) → public_repo
# With token: GraphQL mode (1 call) + 5000 req/hr + file checks
# Without:    REST mode (4 calls) + 60 req/hr
VITE_GITHUB_TOKEN=

# ── LLM API Key (for Hacker Agent AI synthesis) ───────────────────────────
# B.ai:     get at chat.b.ai/key         (format: sk-z8d9w...qb63)
# Anthropic: get at console.anthropic.com (format: sk-ant-api03-...)
# OpenAI:   get at platform.openai.com   (format: sk-...)
VITE_LLM_KEY=

# ── LLM Model choice ─────────────────────────────────────────────────────
# Options: bai | claude | openai
VITE_LLM_MODEL=bai
